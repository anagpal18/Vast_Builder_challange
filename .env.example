# Copy to .env and fill in. Never commit .env.

# --- W&B (Shresth: agents + Weave) ---
WANDB_API_KEY=
WANDB_ENTITY=shresthkumar-karnani-san-jose-state-university
WANDB_PROJECT=almost
LLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B
LLM_THINKING=0

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Memory: "auto" uses Kenil's memory/ package if present, "mock" forces the mock ---
MEMORY_BACKEND=auto

# --- Perception (real footage) ---
YOLO_MODEL=yolo11m.pt
# YOLO_DEVICE=0          # GPU index, or "cpu"

# --- Kenil (NVIDIA + VAST), read by memory/ ---
NVIDIA_API_KEY=
VSS_HOST=
VLM_MODEL=
EMBED_MODEL=
EMBED_DIM=
VAST_ENDPOINT=
VAST_ACCESS_KEY=
VAST_SECRET_KEY=
VAST_BUCKET=
VAST_SCHEMA=
